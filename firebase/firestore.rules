rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownPassword(uid) {
      return request.auth != null && request.auth.uid == uid &&
        request.auth.token.firebase.sign_in_provider == 'password';
    }
    function evidence(uid) {
      return getAfter(/databases/$(database)/documents/authorization_evidence/$(uid)).data;
    }
    function validEvidence(data, uid) {
      return data.keys().hasOnly(['user_id', 'policy_version', 'purposes', 'action', 'accepted', 'authorized_at']) &&
        data.keys().hasAll(['user_id', 'policy_version', 'purposes', 'action', 'accepted', 'authorized_at']) &&
        data.user_id == uid && data.policy_version == 'priva-1.0.0' &&
        data.action == 'account_signup' && data.accepted == true &&
        data.purposes == ['personalized_greeting', 'account_access_recovery'];
    }
    // Existing demo-only contact rules supplied by the project owner.
    // Preserved unchanged; Priva does not collect or access these documents.
    match /demo_contact/{id} {
      allow create: if id.matches('[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}')
        && !exists(/databases/$(database)/documents/privacy_suppressions/$(id))
        && request.resource.data.keys().hasAll(['mode','revision','nameOrAlias','email','message','consent','createdAt'])
        && request.resource.data.keys().hasOnly(['mode','revision','nameOrAlias','email','message','consent','createdAt'])
        && request.resource.data.mode == 'demo'
        && request.resource.data.revision == 'demo-contact-v1'
        && request.resource.data.nameOrAlias in ['Visitante de prueba','Equipo de prueba']
        && request.resource.data.email == 'prueba@example.test'
        && request.resource.data.message in ['Mensaje ficticio para probar el formulario.','Prueba educativa sobre privacidad.','Comprobación de conexión con Firestore.']
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /authorization_evidence/{uid} {
      allow get: if ownPassword(uid);
      allow create: if ownPassword(uid) && validEvidence(request.resource.data, uid) &&
        request.resource.data.authorized_at == request.time &&
        getAfter(/databases/$(database)/documents/profiles/$(uid)).data.name is string;
      allow list, update, delete: if false;
    }
    match /profiles/{uid} {
      allow get: if ownPassword(uid) && request.auth.token.email_verified == true &&
        validEvidence(get(/databases/$(database)/documents/authorization_evidence/$(uid)).data, uid);
      allow create: if ownPassword(uid) &&
        request.resource.data.keys().hasOnly(['name']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        validEvidence(evidence(uid), uid) && evidence(uid).authorized_at == request.time;
      allow update: if ownPassword(uid) && request.auth.token.email_verified == true &&
        validEvidence(get(/databases/$(database)/documents/authorization_evidence/$(uid)).data, uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
        request.resource.data.keys().hasOnly(['name']) &&
        request.resource.data.name is string &&
        request.resource.data.name.matches('(?s).*[^\\s\\p{Z}\\x{FEFF}].*');
      allow list, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
